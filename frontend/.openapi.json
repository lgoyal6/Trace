  "components": {
    "schemas": {
      "BrainRegionOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "atlas_label": {
            "type": "string",
            "title": "Atlas Label"
          },
          "region_literature": {
            "type": "string",
            "title": "Region Literature"
          }
        },
        "type": "object",
        "required": [
          "name",
          "atlas_label",
          "region_literature"
        ],
        "title": "BrainRegionOut"
      },
      "CallSiteBreakdown": {
        "properties": {
          "call_site": {
            "type": "string",
            "title": "Call Site"
          },
          "requests": {
            "type": "integer",
            "title": "Requests"
          },
          "tokens": {
            "type": "integer",
            "title": "Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "call_site",
          "requests",
          "tokens",
          "cost_usd"
        ],
        "title": "CallSiteBreakdown"
      },
      "CallSiteCostOut": {
        "properties": {
          "tokens": {
            "type": "integer",
            "title": "Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "tokens",
          "cost_usd"
        ],
        "title": "CallSiteCostOut"
      },
      "CitationOut": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "pmid": {
            "type": "string",
            "title": "Pmid"
          },
          "supported": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supported"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": ""
          },
          "retrieval_rank": {
            "type": "integer",
            "title": "Retrieval Rank",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "index",
          "pmid",
          "supported",
          "note"
        ],
        "title": "CitationOut",
        "description": "`index` is the [N] slot in the prompt the summary was written against.\n`retrieval_rank` and `source` are the retrieval provenance: the position\nthe record held in the ordering the answer was built from, and the backend\nthat served it. Both are carried through rather than re-derived, so a\nstored answer can still name its sources after the prompt is gone."
      },
      "ClaimVerdictOut": {
        "properties": {
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "cited_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cited Indices"
          },
          "cited_pmids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cited Pmids"
          },
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "best_overlap": {
            "type": "number",
            "title": "Best Overlap"
          },
          "numeric_conflict": {
            "type": "boolean",
            "title": "Numeric Conflict"
          }
        },
        "type": "object",
        "required": [
          "position",
          "text",
          "cited_indices",
          "cited_pmids",
          "verdict",
          "best_overlap",
          "numeric_conflict"
        ],
        "title": "ClaimVerdictOut"
      },
      "ConditionOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "rarity": {
            "type": "string",
            "title": "Rarity"
          },
          "region_literature": {
            "type": "string",
            "title": "Region Literature"
          },
          "atlas_label": {
            "type": "string",
            "title": "Atlas Label"
          },
          "overlaps_with": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Overlaps With"
          }
        },
        "type": "object",
        "required": [
          "name",
          "rarity",
          "region_literature",
          "atlas_label",
          "overlaps_with"
        ],
        "title": "ConditionOut",
        "description": "Consumed by backend/api/routes/conditions.py (Card 1). Keep in sync\nwith backend.app.corpus.conditions.Condition if that shape ever changes."
      },
      "ContrastPaperOut": {
        "properties": {
          "pmid": {
            "type": "string",
            "title": "Pmid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "condition": {
            "type": "string",
            "title": "Condition"
          },
          "rarity": {
            "type": "string",
            "title": "Rarity"
          }
        },
        "type": "object",
        "required": [
          "pmid",
          "title",
          "condition",
          "rarity"
        ],
        "title": "ContrastPaperOut"
      },
      "CostOut": {
        "properties": {
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          },
          "by_call_site": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CallSiteCostOut"
            },
            "type": "object",
            "title": "By Call Site"
          }
        },
        "type": "object",
        "required": [
          "total_tokens",
          "cost_usd",
          "by_call_site"
        ],
        "title": "CostOut"
      },
      "DemoContrastResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "naive": {
            "items": {
              "$ref": "#/components/schemas/ContrastPaperOut"
            },
            "type": "array",
            "title": "Naive"
          },
          "weighted": {
            "items": {
              "$ref": "#/components/schemas/ContrastPaperOut"
            },
            "type": "array",
            "title": "Weighted"
          },
          "rare_case_pmid": {
            "type": "string",
            "title": "Rare Case Pmid"
          }
        },
        "type": "object",
        "required": [
          "query",
          "naive",
          "weighted",
          "rare_case_pmid"
        ],
        "title": "DemoContrastResponse"
      },
      "EconomicsAskOut": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sql": {
            "type": "string",
            "title": "Sql"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sql",
          "rows"
        ],
        "title": "EconomicsAskOut"
      },
      "EconomicsAskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
